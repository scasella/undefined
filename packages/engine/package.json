{
  "name": "@scasella/undefined-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Undefined gates (compile, tests, properties, invariants), evidence, mutation check, decisions and provenance. Host-neutral TypeScript source; never generates code.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/fixtures.ts",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Stephen Casella"
}
