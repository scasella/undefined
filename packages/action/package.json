{
  "name": "@scasella/undefined-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action: certify the exported TypeScript functions a PR touches with the Undefined gates and keep one PR comment up to date. Certifies code from any source; never generates code.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "action.yml",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "dry-run": "UNDEFINED_DRY_RUN=1 node dist/index.js"
  },
  "dependencies": {
    "@scasella/undefined-engine": "0.1.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "rolldown": "1.2.12",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Stephen Casella"
}
