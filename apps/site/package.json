{
  "name": "@scasella/undefined-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Undefined site: a live program that grows the functions you call but haven't written. Static, no backend.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit -p . && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --configLoader runner",
    "record": "node scripts/record.mjs",
    "record:door": "node scripts/record-door.mjs",
    "check:replay": "node scripts/replay-check.mjs",
    "check:csp": "node scripts/csp-check.mjs",
    "check:eject": "node scripts/eject-check.mjs",
    "check:parity": "vitest run --configLoader runner -c scripts/vitest.parity.config.ts",
    "measure:parity": "node scripts/parity-measure.mjs --write"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "@scasella/undefined-engine": "0.1.0",
    "fast-check": "^4.10.2",
    "preact": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Stephen Casella"
}
