{
  "name": "undefined",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A live program that grows the functions you call but haven't written. The model proposes; your toolchain decides.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/site --",
    "build": "npm run build -w apps/site --",
    "build:cli": "npm run build -w packages/cli",
    "preview": "npm run preview -w apps/site --",
    "typecheck": "tsc -p packages/engine && tsc -p packages/engine/tsconfig.test.json && tsc -p packages/cli && tsc -p packages/action && tsc -p apps/site",
    "test": "vitest run --configLoader runner",
    "record": "npm run record -w apps/site --",
    "check:replay": "npm run check:replay -w apps/site",
    "check:csp": "npm run check:csp -w apps/site",
    "check:eject": "npm run check:eject -w apps/site",
    "build:action": "npm run build -w packages/action",
    "check:action-dist": "npm run check:dist -w packages/action",
    "check:cli": "npm run check -w packages/cli",
    "check:parity": "npm run build:cli && npm run check:parity -w apps/site"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Stephen Casella",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scasella/undefined.git"
  },
  "homepage": "https://github.com/scasella/undefined#readme",
  "bugs": {
    "url": "https://github.com/scasella/undefined/issues"
  },
  "keywords": [
    "llm",
    "code-generation",
    "typescript",
    "property-based-testing",
    "fast-check",
    "mutation-testing",
    "codex",
    "vite",
    "preact",
    "web-worker"
  ]
}
