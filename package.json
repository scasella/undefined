{
  "name": "undefined",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A live program that grows the functions you call but haven't written. The model proposes; your toolchain decides.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "record": "node scripts/record.mjs",
    "check:replay": "node scripts/replay-check.mjs",
    "check:csp": "node scripts/csp-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "fast-check": "^4.10.2",
    "preact": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Stephen Casella",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scasella/undefined.git"
  },
  "homepage": "https://github.com/scasella/undefined#readme",
  "bugs": {
    "url": "https://github.com/scasella/undefined/issues"
  },
  "keywords": [
    "llm",
    "code-generation",
    "typescript",
    "property-based-testing",
    "fast-check",
    "mutation-testing",
    "codex",
    "vite",
    "preact",
    "web-worker"
  ]
}
